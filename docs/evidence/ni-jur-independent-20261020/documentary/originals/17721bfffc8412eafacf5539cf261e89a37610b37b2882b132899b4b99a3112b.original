        line-height: 16px !important;
        font: -webkit-control;
    }
    .popup-message .close-btn {
        position: absolute;
        top: 4px;
        right: 5px;
        cursor: pointer;
        font-size: 16px;
        border: 1px solid;
        border-radius: 100%;
        width: 16px;
        height: 16px;
        display: flex;
        transition: background 0.2s ease-in-out;
        justify-content: center;
        align-items: center;
        flex-wrap: nowrap;
        flex-direction: column;
    }
    .popup-message .close-btn:hover {
        background-color: rgb(255 44 44 / 70%);
