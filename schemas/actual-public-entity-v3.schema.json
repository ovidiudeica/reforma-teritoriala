{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovidiudeica.github.io/reforma-teritoriala/schemas/actual-public-entity-v3.schema.json",
  "title": "Reforma Teritorială — ACTUAL public entity contract v3",
  "type": "object",
  "required": ["schema_version","contract","mode","entity_count","administrative_entity_count","statistical_only_entity_count","hierarchy_tree","entities"],
  "properties": {
    "schema_version": {"const": 3},
    "contract": {"const": "actual-public-entity-v3"},
    "mode": {"const": "ACTUAL"},
    "generated_at": {"type": ["string","null"]},
    "entity_count": {"const": 5848},
    "administrative_entity_count": {"const": 5830},
    "statistical_only_entity_count": {"const": 18},
    "entity_count_by_jurisdiction": {
      "type":"object",
      "required":["RO","MD"],
      "properties":{"RO":{"const":3246},"MD":{"const":2602}}
    },
    "hierarchy_tree": {
      "type":"object",
      "required":["contract","root_count","roots","node_count","nodes"],
      "properties":{
        "contract":{"const":"actual-public-hierarchy-v1"},
        "root_count":{"const":2},
        "node_count":{"const":5848}
      }
    },
    "entities": {
      "type":"array",
      "minItems":5848,
      "maxItems":5848,
      "items":{"$ref":"#/$defs/entity"}
    }
  },
  "$defs": {
    "entity": {
      "type":"object",
      "required":["id","status","jurisdiction","display_name","display_type","roles","legal","hierarchy","representation","validation","map"],
      "properties":{
        "id":{"type":"string","pattern":"^(?:osm-r[0-9]+|siruta-u[0-9]+|stat-(?:RO|MD)[A-Z0-9]+)$"},
        "status":{"const":"current"},
        "jurisdiction":{"enum":["RO","MD"]},
        "category":{"enum":["administrative","context","statistical"]},
        "roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["administrative","statistical"]}},
        "statistical":{"type":["object","null"]},
        "statistical_membership":{"type":["object","null"]},
        "hierarchy":{
          "type":"object",
          "required":["administrative_parent_id","statistical_parent_id","navigation_parent_id"],
          "properties":{
            "administrative_parent_id":{"type":["string","null"]},
            "statistical_parent_id":{"type":["string","null"]},
            "navigation_parent_id":{"type":["string","null"]},
            "navigation_parent_kind":{"enum":["administrative","statistical",null]}
          }
        },
        "representation":{
          "type":"object",
          "required":["source","osm_relation_id","geometry_source","geometry_role","public_geometry_precision","canonical_geometry_role","geometry_scope"],
          "properties":{
            "source":{"enum":["OpenStreetMap","ANCPI RELUAT"]},
            "osm_relation_id":{"type":["integer","null"]},
            "admin_level":{"type":["integer","string","null"]},
            "geometry_role":{"enum":["current_representation","statistical_representation"]},
            "public_geometry_precision":{"enum":["master_coordinate_fidelity","source_snapshot_coordinate_fidelity"]},
            "canonical_geometry_role":{"type":["string","null"]},
            "geometry_scope":{"type":["string","null"]}
          }
        }
      }
    }
  }
}
