{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ovidiudeica.github.io/reforma-teritoriala/schemas/actual-public-entity-v3.schema.json",
  "title":"Reforma Teritorială — ACTUAL public entity contract v3",
  "type":"object",
  "required":["schema_version","contract","mode","entity_count","administrative_entity_count","statistical_only_entity_count","hierarchy","statistical_geometry","entities"],
  "properties":{
    "schema_version":{"const":3},
    "contract":{"const":"actual-public-entity-v3"},
    "mode":{"const":"ACTUAL"},
    "generated_at":{"type":["string","null"]},
    "entity_count":{"type":"integer","minimum":0},
    "administrative_entity_count":{"type":"integer","minimum":0},
    "statistical_only_entity_count":{"type":"integer","minimum":0},
    "statistical_role_entity_count":{"type":"integer","minimum":0},
    "hierarchy":{
      "type":"object",
      "required":["contract","path","root_ids","node_count"],
      "properties":{
        "contract":{"const":"actual-consolidated-hierarchy-v1"},
        "path":{"type":"string"},
        "root_ids":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string"}},
        "node_count":{"type":"integer","minimum":0}
      }
    },
    "statistical_geometry":{"type":"object"},
    "entities":{"type":"array","items":{"$ref":"#/$defs/entity"}}
  },
  "$defs":{
    "entity":{
      "type":"object",
      "required":["id","status","jurisdiction","display_name","display_type","roles","legal","hierarchy","representation","validation","map"],
      "properties":{
        "id":{"type":"string","pattern":"^(?:osm-r[0-9]+|siruta-u[0-9]+|stat-(?:RO|MD)[A-Z0-9]+)$"},
        "status":{"const":"current"},
        "jurisdiction":{"enum":["RO","MD"]},
        "display_name":{"type":"string"},
        "display_type":{"type":"string"},
        "roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["administrative","statistical","context"]}},
        "legal":{"type":["object","null"]},
        "statistical":{
          "anyOf":[
            {"type":"null"},
            {"type":"object","required":["classification","version","code","level","parent_code","parent_entity_id","identity_authority"],"properties":{
              "classification":{"type":"string"},"version":{"type":"string"},"code":{"type":"string"},"level":{"enum":[1,2,3]},
              "parent_code":{"type":["string","null"]},"parent_entity_id":{"type":["string","null"]},"identity_authority":{"type":"string"}
            }}
          ]
        },
        "hierarchy":{
          "type":"object",
          "required":["parent_catalog_id","administrative_parent_id","statistical_parent_id","consolidated_parent_id"],
          "properties":{
            "parent_catalog_id":{"type":["string","null"]},"administrative_parent_id":{"type":["string","null"]},
            "statistical_parent_id":{"type":["string","null"]},"consolidated_parent_id":{"type":["string","null"]}
          }
        },
        "representation":{
          "type":"object",
          "required":["source","osm_relation_id","admin_level","geometry_source","geometry_role","public_geometry_precision","canonical_geometry_role","geometry_scope"],
          "properties":{
            "source":{"enum":["OpenStreetMap","ANCPI RELUAT"]},
            "osm_relation_id":{"type":["integer","null"]},"admin_level":{"type":["integer","string","null"]},
            "geometry_source":{"type":"string"},"geometry_role":{"const":"current_representation"},
            "public_geometry_precision":{"const":"master_coordinate_fidelity"},
            "canonical_geometry_role":{"type":["string","null"]},"geometry_scope":{"type":["string","null"]}
          }
        },
        "validation":{"type":"object"},
        "map":{
          "type":"object","required":["tier","bbox","center"],
          "properties":{"tier":{"enum":["overview","local","detail"]},"bbox":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"}},"center":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}}
        }
      }
    }
  }
}
